{
  "name": "clinicore-backend",
  "version": "1.0.0",
  "description": "Clinicore Clinic OS — CRM + Mood Detection Backend",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "npx prisma generate && npm run build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "npx prisma migrate deploy && node dist/server.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "npx prisma generate",
    "seed": "ts-node src/db/seed.ts",
    "db:test": "ts-node src/db/test-connection.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.43.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "prisma": "^6.19.3",
    "resend": "^6.12.3",
    "twilio": "^6.0.2",
    "ws": "^8.21.0",
    "zod": "^3.23.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/twilio": "^3.19.2",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  }
}
